{
  "datasets": [
    {
      "name": "processed_records_by_layer",
      "displayName": "Registros procesados por capa",
      "queryLines": [
        "SELECT\n",
        "  event_date,\n",
        "  layer,\n",
        "  SUM(processed_records) AS processed_records\n",
        "FROM\n",
        "  fintech_finpay.observability.v_processed_records_by_layer\n",
        "GROUP BY\n",
        "  event_date,\n",
        "  layer"
      ]
    },
    {
      "name": "rejected_records",
      "displayName": "Registros rechazados por calidad",
      "queryLines": [
        "SELECT event_date, layer, source_name, rejection_reason, SUM(rejected_records) AS rejected_records FROM fintech_finpay.observability.v_rejected_records GROUP BY event_date, layer, source_name, rejection_reason ORDER BY event_date, layer, source_name"
      ]
    },
    {
      "name": "rejection_rate_by_layer",
      "displayName": "Tasa de rechazo por capa",
      "queryLines": [
        "SELECT event_date, layer, processed_records, rejected_records, rejection_rate FROM fintech_finpay.observability.v_rejection_rate_by_layer ORDER BY event_date, layer"
      ]
    },
    {
      "name": "flow_progress",
      "displayName": "Progreso por flujo",
      "queryLines": [
        "SELECT\n",
        "  event_date,\n",
        "  layer,\n",
        "  flow_name,\n",
        "  flow_status,\n",
        "  input_records,\n",
        "  processed_records\n",
        "FROM\n",
        "  fintech_finpay.observability.v_processed_records_by_layer"
      ]
    },
    {
      "name": "overall_rejection_rate_kpi",
      "displayName": "Overall Rejection Rate KPI",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN SUM(processed_records) = 0 THEN 0\n",
        "    ELSE SUM(rejected_records) / SUM(processed_records)\n",
        "  END AS overall_rejection_rate\n",
        "FROM\n",
        "  fintech_finpay.observability.v_rejection_rate_by_layer"
      ]
    },
    {
      "name": "total_rejected_kpi",
      "displayName": "Total Rejected Records KPI",
      "queryLines": [
        "SELECT\n",
        "  SUM(rejected_records) AS total_rejected_records\n",
        "FROM\n",
        "  fintech_finpay.observability.v_rejected_records"
      ]
    },
    {
      "name": "total_processed_kpi",
      "displayName": "Total Processed Records KPI",
      "queryLines": [
        "SELECT\n",
        "  SUM(processed_records) AS total_processed_records\n",
        "FROM\n",
        "  fintech_finpay.observability.v_processed_records_by_layer"
      ]
    }
  ],
